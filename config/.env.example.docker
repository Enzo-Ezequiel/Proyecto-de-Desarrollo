### Configuración para Ejecución en Contenedores (Docker)
APP_NAME="Repositorio Desarrollo"
APP_VERSION="0.1.0"
DEBUG=False
HOST=0.0.0.0
PORT=8000

### CORS
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000"]

### Mongo BD (Conexión entre contenedores)
MONGO_DB_NAME="repositorio_db"
DATABASE_URL="mongodb://host.docker.internal:27017"

### Límites de archivos PDF
PDF_MAX_SIZE_MB=5
LOG_LEVEL="INFO"